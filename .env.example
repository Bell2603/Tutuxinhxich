# Sao chép thành .env.local (local: chạy `npm run env:local` để tự điền từ Supabase local).
# KHÔNG commit file .env.local / .env.production.

# URL công khai của website (dùng cho SEO, link xác nhận email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API (local: `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Khóa bí mật — CHỈ dùng cho scripts/ và tests/ (tạo tài khoản mẫu, dọn dữ liệu test).
# Website KHÔNG cần khóa này; tuyệt đối không đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Tài khoản mẫu cho môi trường LOCAL (npm run db:seed-users)
SEED_ADMIN_EMAIL=admin@tutuxinhxich.local
SEED_ADMIN_PASSWORD=TuTuAdmin@2026
SEED_CUSTOMER_EMAIL=khach@tutuxinhxich.local
SEED_CUSTOMER_PASSWORD=KhachXinh@2026
